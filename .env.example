# ==============================================================================
# Configuration template for smarthome-hub.
#
# Copy to .env and GENERATE YOUR OWN SECRETS:
#     cp .env.example .env && make secrets
#
# The .env file is git-ignored and must never be committed (ADR-0007).
# Every value below is fictional and serves only as an example.
# ==============================================================================

# --- Installation identity ----------------------------------------------------
# Use a UUID you generate yourself. Do NOT use anything that identifies your
# address, surname or Wi-Fi network — this value appears in logs and MQTT topics.
HUB_HOME_ID=00000000-0000-0000-0000-000000000000

# --- HTTP ---------------------------------------------------------------------
HUB_HTTP_ADDR=:8080
HUB_LOG_LEVEL=info
HUB_LOG_JSON=false

# --- PostgreSQL / TimescaleDB -------------------------------------------------
POSTGRES_USER=smarthome
POSTGRES_PASSWORD=replace-me-with-a-generated-secret
POSTGRES_DB=smarthome
HUB_DB_DSN=postgres://smarthome:replace-me-with-a-generated-secret@localhost:5432/smarthome?sslmode=disable
HUB_DB_MAX_CONNS=10

# --- MQTT broker --------------------------------------------------------------
HUB_MQTT_URL=mqtt://localhost:1883
HUB_MQTT_CLIENT_ID=smarthome-hub
HUB_MQTT_USERNAME=smarthome-hub
HUB_MQTT_PASSWORD=replace-me-with-a-generated-secret

# Credentials used by the broker container (healthcheck and passwd generation).
# They must match HUB_MQTT_USERNAME / HUB_MQTT_PASSWORD.
MQTT_HUB_USERNAME=smarthome-hub
MQTT_HUB_PASSWORD=replace-me-with-a-generated-secret
